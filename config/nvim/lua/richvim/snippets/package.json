      },
      {
        "language": "yaml",
        "path": "./yaml/yaml-general.json"
      },
      {
        "language": "yaml",
        "path": "./yaml/yaml-intrinsic-functions.json"
      },
      {
        "language": "yaml",
        "path": "./yaml/yaml-parameter-types.json"
      },
      {
        "language": "yaml",
        "path": "./yaml/yaml-resource-types.json"
      }
    ]
  }
}
